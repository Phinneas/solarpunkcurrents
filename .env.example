# S3 / Cloudflare R2 (CLI-only — the Worker uses R2 bindings directly)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=solarpunkcurrents
S3_REGION=auto

# Parallel Extract (optional — secondary scraper, $1/1000 URLs, https://parallel.ai)
# Jina Reader (free) is primary; native fetch is the final fallback.
PARALLEL_API_KEY=

# Exa AI Search (optional — discovery search, https://exa.ai)
EXA_API_KEY=

# Tavily Search (optional — supplementary discovery search, https://tavily.com)
TAVILY_API_KEY=

# Pexels API (optional — hero images for newsletter, free at https://www.pexels.com/api)
PEXELS_API_KEY=

# LLM Providers
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# GitHub (publish: commits newsletter draft to solarcurrents repo)
GITHUB_TOKEN=

# Email Delivery (Resend - https://resend.com, CLI-only)
RESEND_API_KEY=
NEWSLETTER_RECIPIENTS=
